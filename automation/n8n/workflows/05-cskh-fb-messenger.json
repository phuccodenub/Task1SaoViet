    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "meta/messenger",
        "responseMode": "responseNode",
        "options": { "rawBody": true }
      },
      "id": "events-post",
      "name": "Webhook — events (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 500],
      "webhookId": "fb-messenger-events"
    },
    {
      "parameters": {
        "jsCode": "// Verify X-Hub-Signature-256 against FB_APP_SECRET.\n// require() is mandatory inside n8n Code nodes; also relies on\n// NODE_FUNCTION_ALLOW_BUILTIN=crypto being set on the n8n container.\nconst crypto = require('crypto');\nconst sig = $input.first().headers['x-hub-signature-256'];\nconst raw = $input.first().body;\nconst rawStr = typeof raw === 'string' ? raw : JSON.stringify(raw);\nconst expected = 'sha256=' + crypto.createHmac('sha256', $env.FB_APP_SECRET).update(rawStr).digest('hex');\nif (!sig) throw new Error('missing_signature');\nconst expBuf = Buffer.from(expected);\nconst sigBuf = Buffer.from(sig);\nif (expBuf.length !== sigBuf.length || !crypto.timingSafeEqual(expBuf, sigBuf)) {\n  throw new Error('bad_signature');\n}\nconst body = typeof raw === 'string' ? JSON.parse(raw) : raw;\nconst out = [];\nfor (const entry of body.entry || []) {\n  for (const ev of entry.messaging || []) {\n    if (!ev.message || ev.message.is_echo) continue;\n    out.push({ json: {\n      psid: ev.sender.id,\n      pageId: entry.id,\n      text: ev.message.text || '',\n      mid: ev.message.mid,\n      timestamp: ev.timestamp\n    }});\n  }\n}\nreturn out;"
      },
      "id": "parse-events",
      "name": "Verify + parse events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 500]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "EVENT_RECEIVED",
        "options": {}
      },
      "id": "ack-fb",
      "name": "Ack 200 to Meta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [420, 380],
      "notesInFlow": true,
      "notes": "Fan-out target #1 of Webhook POST (single output, two downstream nodes). Replies EVENT_RECEIVED within Meta's 20s deadline while Verify+parse continues asynchronously. Webhook node has only ONE output in n8n — connection JSON uses multiple entries inside main[0], NOT main[1]."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO omni.external_messages (org_id, channel, external_user_id, external_thread_id, external_message_id, sender_type, sender_name, content, content_type, raw_payload, received_at)\nVALUES ($1, 'facebook', $2, $2, $3, 'contact', NULL, $4, 'text', $5::jsonb, to_timestamp($6::bigint / 1000.0))\nON CONFLICT (channel, external_message_id) DO NOTHING\nRETURNING id;",
        "additionalFields": {
          "queryParams": "={{ $env.ZALOCRM_ORG_ID }},={{ $json.psid }},={{ $json.mid }},={{ $json.text }},={{ JSON.stringify($json) }},={{ $json.timestamp }}"
        }
      },
      "id": "store-msg",
      "name": "Store external_messages",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [660, 500],
      "credentials": { "postgres": { "id": "pg-zalocrm", "name": "Postgres — ZaloCRM" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://litellm:4000/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "=Bearer {{ $env.LITELLM_KEY_CSKH }}" },
          { "name": "Content-Type", "value": "application/json" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"cheap-vi\",\n  \"temperature\": 0,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"Phân loại CSKH. Trả JSON: {\\\"intent\\\":\\\"greeting|faq_price|faq_product|order_status|complaint|lead_qualified|spam|other\\\",\\\"confidence\\\":0-1,\\\"needsHuman\\\":true|false}\" },\n    { \"role\": \"user\", \"content\": \"{{ $('Verify + parse events').first().json.text }}\" }\n  ]\n}",
        "options": { "timeout": 15000, "retry": { "maxTries": 2 } }
      },
      "id": "classify-fb",
      "name": "Classify intent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 500]
    },
    {
      "parameters": {
        "jsCode": "const r = JSON.parse($input.first().json.choices?.[0]?.message?.content || '{}');\nconst e = $('Verify + parse events').first().json;\nreturn [{ json: { ...e, ...r, shadow: ($env.CSKH_SHADOW_MODE ?? 'true') === 'true' } }];"
      },
      "id": "merge-fb",
      "name": "Merge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 500]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ $json.needsHuman }}", "rightValue": "false", "operator": { "type": "boolean", "operation": "equals" } },
            { "leftValue": "={{ $json.shadow }}",     "rightValue": "false", "operator": { "type": "boolean", "operation": "equals" } }
          ],
          "combinator": "and"
        }
      },
      "id": "if-send-fb",
      "name": "Auto-send?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1320, 500]
    },
    {
      "parameters": {
