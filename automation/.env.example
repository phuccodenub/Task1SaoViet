# ─── Shared Postgres (match ZaloCRM/.env) ────────────────────────────────────
DB_USER=crmuser
DB_PASSWORD=change-me-match-zalocrm
DB_NAME=zalocrm

# ─── LiteLLM gateway ─────────────────────────────────────────────────────────
# Master key used by n8n + ZaloCRM to authenticate against the gateway.
# Generate: openssl rand -hex 32   → prefix with "sk-"
LITELLM_MASTER_KEY=sk-change-me-32-hex
# Salt key for encrypting provider keys stored in DB. Never rotate without re-encrypting.
LITELLM_SALT_KEY=change-me-32-hex
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=change-me-strong

# Virtual keys (generated in LiteLLM UI after first-boot, one per team/budget).
# Referenced by n8n workflows as Authorization: "=Bearer {{ $env.LITELLM_KEY_* }}"
LITELLM_KEY_CONTENT=sk-content-change-me
LITELLM_KEY_CSKH=sk-cskh-change-me

# Optional Slack / Telegram webhook LiteLLM uses to alert on budget / failure.
# Leave empty to disable alerts.
LITELLM_ALERT_WEBHOOK=

# Provider API keys — leave blank for providers you don't use.
# Kimi (Moonshot)  — cheapest Vietnamese-friendly model for intent + rewrite
KIMI_API_KEY=
# Gemini 1.5/2.0 Flash — free tier 15 RPM, good for sentiment/guardrail
GEMINI_API_KEY=
# Qwen (DashScope) — Alibaba, strong Vietnamese
QWEN_API_KEY=
# MiniMax — Vietnamese fluent, cheap
MINIMAX_API_KEY=
# OpenRouter fallback for any GLM/other models not natively supported
OPENROUTER_API_KEY=
# Escalation tier (use sparingly for complaint / VIP replies)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-strong

# ─── n8n ─────────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-strong
# 32+ char random string — used to encrypt credentials in n8n DB. NEVER change after workflows are saved.
N8N_ENCRYPTION_KEY=change-me-32-hex-min
N8N_HOST=n8n.yourdomain.com
N8N_PROTOCOL=https
# Public URL n8n uses when generating webhook URLs (give ZaloCRM/Facebook/TikTok this prefix)
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/

# ─── ZaloCRM integration (filled in after Phase 1.3 bootstrap) ───────────────
ZALOCRM_BASE_URL=http://zalo-crm-app:3000
ZALOCRM_API_KEY=
ZALOCRM_WEBHOOK_SECRET=
# orgId of the default tenant — read via psql after ZaloCRM first-run
ZALOCRM_ORG_ID=

# ─── Facebook Graph API (filled in at Phase 2.1) ─────────────────────────────
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=change-me-webhook-verify-token
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# ─── TikTok (filled in at Phase 2.2) ─────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ─── Google Sheets (content review queue) ────────────────────────────────────
# Path to service-account JSON, mounted into n8n as Google credential
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_CONTENT_INBOX_ID=
GOOGLE_SHEETS_REVIEW_QUEUE_ID=
GOOGLE_SHEETS_REVIEW_QUEUE_URL=

# ─── Telegram alerts (Uptime Kuma + n8n) ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_SALES_CHAT_ID=

# ─── OpenClaw (self-hosted AI assistant for browser/QA/scraper skills) ───────
# Base URL is the internal docker network name when co-located with the n8n
# stack; switch to https://openclaw.yourdomain.com for multi-host deployments.
OPENCLAW_BASE_URL=http://openclaw:8000
OPENCLAW_API_KEY=
OPENCLAW_LOG_DIR=./openclaw/logs

# ─── CSKH bot behaviour ──────────────────────────────────────────────────────
# When 'true' (default), workflow 04 / 05 log the drafted reply but DO NOT send
# it to Zalo / Messenger. Flip to 'false' only after a human-review pass of the
# omni.intent_log rows confirms the bot is safe.
CSKH_SHADOW_MODE=true

# ─── Monitoring (Grafana admin account) ──────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change-me-strong
